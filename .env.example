# Database configuration

MYSQL_DATABASE= # Enter database name for ex - parkx
MYSQL_ROOT_PASSWORD= # set root user password 
MYSQL_USER= # set user name for ex- parkx_app
MYSQL_PASSWORD= # set user password


# Registration and otp expiry time

PENDING_REGISTRATION_EXPIRY_DAYS= # Enter the no. of days for ex - 7
OTP_EXPIRY_MINUTES= # set OTP Expiry time in minutes , for ex - 5

#Email configurations

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com # Enter Email
EMAIL_HOST_PASSWORD=your-app-password # Enter app Password
DEFAULT_FROM_EMAIL=your-email@gmail.com #Enter Email